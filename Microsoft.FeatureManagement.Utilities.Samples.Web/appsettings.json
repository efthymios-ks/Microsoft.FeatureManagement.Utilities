{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FeatureManagement": {
    "Shipping.UseExpressCarrier": true,
    "Shipping.UseLiveTracking": true,
    "Pricing.V2": true,
    "Pricing.V3": false,
    "Recommendations": true,
    "Recommendations.Personalized": false,
    "Orders.NewOrders": false,
    "Promotions": {
      "EnabledFor": [
        {
          "Name": "Microsoft.Percentage",
          "Parameters": { "Value": 50 }
        }
      ]
    }
  }
}
